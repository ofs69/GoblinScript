# Generated by export_bundle.py -- hundreds of MB of ONNX graphs + the manifest
# that describes them (bundle/ fp32, bundle_fp16/ fp16). Reproducible from a
# checkpoint; never committed.
bundle*/
__pycache__/

# Rust build artifacts.
target/

# Working files of an in-flight (or interrupted) draft; a finished draft
# removes its own.
cache/

# Packed distribution zips (cargo xtask dist).
dist/

# The soundtrack. build.rs turns every `.mid` in here into the playlist baked
# into the exe, and it is not part of the source distribution -- a checkout
# without one builds and tests exactly the same, and runs silent (see
# `sound.rs`). Dropping .mid files in here is all it takes to have one.
music/

# What the app writes when a draft fails (goblinscript.log, beside the exe) and
# what `cargo xtask dist` leaves behind. Both land inside the tree when the app
# is run or packed from here.
*.log

# NVIDIA's redistributable CUDA 12 and cuDNN 9 libraries, which a CUDA zip
# carries beside the binary (see `CUDA_RUNTIME_WINDOWS` in xtask). They are
# NVIDIA's downloads, ~1.3 GB of them, and the release workflow unpacks them
# here from the redistributable archives. `CUDA_LIBS_DIR` points elsewhere.
cuda-libs*/
